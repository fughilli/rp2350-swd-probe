"""Turn a bare RP2350 (Raspberry Pi Pico 2) into a CMSIS-DAP SWD debug probe.

Two jobs, both built on github.com/fughilli/embedded (bzlmod module `firmware`)
so the tooling matches the sibling firmware repos — no re-derived toolchains:

  * `bazel run //:flash_probe`  — flash Raspberry Pi's stock `debugprobe`
    firmware onto a fresh RP2350 via @firmware's hermetic `picotool`
    (`picotool_flash` rule, //rules:flash.bzl).
  * `tools/gdbserver.sh`        — run @firmware's hermetic pyOCD
    (`//tools/pyocd`, with its Nix libusb backend) as a GDB server over the
    probe, exposed to a remote for remote flash/debug.
"""

module(
    name = "rp2350_swd_probe",
    version = "0.0.0",
    compatibility_level = 1,
)

# The embedded firmware infra (Nix-provided picotool + pyOCD, the picotool_flash
# rule, the //tools/pyocd gdbserver). Pinned to the branch carrying the
# picotool_flash pass-through-args fix (PR #10) so `flash_probe -- -f` works;
# re-pin to master once that merges.
bazel_dep(name = "firmware", version = "0.0.0")
git_override(
    module_name = "firmware",
    remote = "https://github.com/fughilli/embedded",
    commit = "ed8a3f7272b8a6d90747072f3c62a35d7bbb5cff",
)

# CMSIS Device Family Packs for pyOCD targets outside its built-ins, vendored
# via @firmware's mechanism: tools/pyocd/packs.in -> packs.lock (relocked with
# `bazel run @firmware//tools/pyocd:update_packs -- --packs-in tools/pyocd/packs.in
# --lock tools/pyocd/packs.lock`) -> this hub, carried by our //tools/pyocd:pyocd.
# A distinct hub_name keeps our packs separate from @firmware's own `cmsis_packs`.
cmsis = use_extension("@firmware//rules:cmsis_pack.bzl", "cmsis_packs")
cmsis.parse(
    lock = "//tools/pyocd:packs.lock",
    hub_name = "rp2350_cmsis_packs",
)
use_repo(cmsis, "rp2350_cmsis_packs")

# --- debugprobe firmware images (official RPi release, pinned) --------------
# https://github.com/raspberrypi/debugprobe/releases/tag/debugprobe-v2.3.1
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# RP2350 / Pico 2 — this is the one you want for a Pico 2 probe.
http_file(
    name = "debugprobe_on_pico2_uf2",
    urls = ["https://github.com/raspberrypi/debugprobe/releases/download/debugprobe-v2.3.1/debugprobe_on_pico2.uf2"],
    sha256 = "98cbb993872e4bb7bf7ac064cef8986cda171b9e783ef6ce1544873d7b704621",
    downloaded_file_path = "debugprobe_on_pico2.uf2",
)

# RP2040 / original Pico — kept for convenience (//:flash_probe_pico).
http_file(
    name = "debugprobe_on_pico_uf2",
    urls = ["https://github.com/raspberrypi/debugprobe/releases/download/debugprobe-v2.3.1/debugprobe_on_pico.uf2"],
    sha256 = "6649ebba11df46cfa6cfa1faec9706bd21303893cf3f1e40067284bd4e3792d4",
    downloaded_file_path = "debugprobe_on_pico.uf2",
)
